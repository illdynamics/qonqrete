# QonQrete Configuration

agents:
  instruqtor:
    provider: deepseek
    model: deepseek-chat

  construqtor:
    provider: deepseek
    model: deepseek-chat

  inspeqtor:
    provider: deepseek
    model: deepseek-chat

options:
  # Cheqpoint Configuration
  # true = User-gated mode by default (cheqpoints enabled).
  # false = Autonomous mode by default (cheqpoints disabled).
  cheqpoint: false

  # Max number of cycles to run in auto-mode.
  auto_cycle_limit: 1

  # Briq Granularity Control (0-9)
  # 0 = Atomic (Every bullet is a file)
  # 5 = Balanced
  # 9 = Monolithic (Whole task is one file)
  briq_sensitivity: 9

  # Operational Mode
  # Options: program, enterprise, performance, security, innovative, balanced
  mode: program
