# ═══════════════════════════════════════════════════════════════════════════════
# QonQrete Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# v1.7.1-stable - Includes TimeWalQer time travel settings
#
# Copy this file to your worqspace as config.yaml and customize.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# CORE SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

# Maximum cyQles to run (0 = unlimited)
max_cyqles: 10

# Sensitivity for task splitting (1-10, higher = more splits)
sensitivity: 7

# Mode: program, enterprise, innovative
mode: program

# ─────────────────────────────────────────────────────────────────────────────
# PIPELINE AGENTS
# ─────────────────────────────────────────────────────────────────────────────

# InstruQtor - Task splitting agent
instruqtor:
  enabled: true
  provider: local  # 'local' for zero-cost, or 'openai', 'anthropic', etc.
  model: instruqtor
  sensitivity: 7

# ConstruQtor - Code generation agent
construqtor:
  enabled: true
  provider: local  # 'local' for mindstaQ patterns, or AI provider
  model: construqtor

# InspeQtor - Code review agent
inspeqtor:
  enabled: true
  provider: local  # 'local' for zero-cost AST analysis
  model: inspeqtor
  mode: program    # program, enterprise, innovative
  check_imports: true
  check_security: true
  check_style: true

# ─────────────────────────────────────────────────────────────────────────────
# EVOLUTION LOOP (v1.7.0)
# ─────────────────────────────────────────────────────────────────────────────

# Qalibrator - AST mutation engine
qalibrator:
  enabled: true
  max_generations: 50
  population_size: 5
  mutation_rate: 0.3
  elite_count: 2
  convergence_threshold: 0.001
  stagnation_limit: 10
  enabled_mutations:
    - swap_statements
    - swap_operators
    - swap_conditionals
    - inline_variable
    - add_error_handling
    - remove_dead_code
    - simplify_boolean
    - reorder_imports

# Qualifier - Quality assessment agent
qualifier:
  enabled: true
  min_fitness: 0.70
  max_iterations: 50
  stagnation_limit: 10
  # See quality_qriteria.yaml for detailed dimension settings

# ─────────────────────────────────────────────────────────────────────────────
# TIMEWALQER - TIME TRAVEL SYSTEM (v1.7.1)
# ─────────────────────────────────────────────────────────────────────────────

timewalqer:
  # Enable/disable the time travel system
  enabled: true
  
  # Use hard links for storage efficiency (cp -al instead of cp -r)
  # This makes 100 snapshots take ~1x storage instead of 100x
  use_hardlinks: true
  
  # Auto-revert to last good state on hard failures
  auto_revert: true
  
  # Maximum timestones to keep (0 = unlimited)
  # Older timestones are cleaned up, but Genesis (0) is always kept
  max_timestones: 100
  
  # Track failed attempts in graveyard.d for forensics
  graveyard_enabled: true
  
  # Directories to include in snapshots
  snapshot_dirs:
    - qodeyard
    - qontext.d
    - bloq.d
    - tasq.d
    - reqap.d
    - briq.d
    - struqture
  
  # Files to include in snapshots
  snapshot_files:
    - config.yaml
    - tasq.md

# ─────────────────────────────────────────────────────────────────────────────
# PROVIDER SETTINGS (if using AI providers)
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI settings
openai:
  api_key: ${OPENAI_API_KEY}
  model: gpt-4
  temperature: 0.7

# Anthropic settings
anthropic:
  api_key: ${ANTHROPIC_API_KEY}
  model: claude-3-sonnet
  temperature: 0.7

# Ollama settings (local)
ollama:
  base_url: http://localhost:11434
  model: codellama

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING & DEBUG
# ─────────────────────────────────────────────────────────────────────────────

logging:
  level: INFO  # DEBUG, INFO, WARNING, ERROR
  file: struqture/qonqrete.log
  format: "%(asctime)s [%(levelname)s] %(name)s: %(message)s"

debug:
  verbose: false
  trace_agents: false
  save_intermediates: false

# ─────────────────────────────────────────────────────────────────────────────
# MINDSTAQ SETTINGS (v1.9.7)
# ─────────────────────────────────────────────────────────────────────────────

mindstaq:
  # Triple Threat Mode - Run ALL tiers in parallel and combine best results!
  # This triples the generation power at zero extra cost.
  triple_threat:
    enabled: true    # Set to true for maximum quality
    timeout: 30      # Seconds to wait for all tiers
  
  # Qomputator complexity thresholds
  qomputator:
    thresholds:
      tier_0_max: 100   # 0-100: Qrystallizer (templates)
      tier_1_max: 400   # 101-400: SQavenger (web search + patterns)
                        # 401-666: Qombinator (frankenstein + breeding)
  
  # Qonscience verification settings
  qonscience:
    max_iterations: 5
    auto_fix:
      syntax_errors: true
      import_errors: true


# ─────────────────────────────────────────────────────────────────────────────
# SQAVANGER SETTINGS (v1.9.9) - Web Search Configuration
# ─────────────────────────────────────────────────────────────────────────────
sqavanger:
  # v1.9.9: Enable offline mode to skip ALL web searches (much faster!)
  # When true, immediately falls back to OFFLINE_PATTERNS
  offline_mode: true    # Set to true for maximum speed (no network waits)
  
  # Timeout for web searches (seconds) - reduced from 30 to 5 in v1.9.9
  timeout: 5
  
  # Maximum results per search query
  max_results: 5
