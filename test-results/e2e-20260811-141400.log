[0m[35m[instruQtor] stderr # (arch/arm64/boot/Image[.gz]) but does NOT flash or boot on physical hardware.
[0m[35m[instruQtor] stderr #
[0m[35m[instruQtor] stderr # Requirements (installed on the CI runner, not provided by this script):
[0m[35m[instruQtor] stderr #   * gcc-aarch64-linux-gnu (GNU AArch64 cross toolchain), or an equivalent
[0m[35m[instruQtor] stderr #     toolchain whose compilers are prefixed `aarch64-linux-gnu-`.
[0m[35m[instruQtor] stderr #   * A reasonably-provisioned runner (>= 8 GB RAM, >= 4 cores recommended).
