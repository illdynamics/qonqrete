[0m[35m[instruQtor] stderr #   KERNEL_BRANCH to point at the published vendor tree when available, the
[0m[35m[instruQtor] stderr #   same way images/build.sh does.
[0m[35m[instruQtor] stderr #
[0m[35m[instruQtor] stderr # This job is intended to be invoked by the CI pipeline (see ci/*.sh). It
