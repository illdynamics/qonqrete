[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr set -euo pipefail
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr NUXEL_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
[0m[35m[instruQtor] stderr WORK_DIR="${NUXEL_KERNEL_WORK_DIR:-${NUXEL_ROOT}/build/kernel-ci}"
[0m[35m[instruQtor] stderr ARTIFACT_DIR="${NUXEL_KERNEL_ARTIFACT_DIR:-${NUXEL_ROOT}/build/kernel-ci-artifacts}"
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr # Configurable via environment; defaults match images/build.sh.
[0m[35m[instruQtor] stderr KERNEL_REPO="${KERNEL_REPO:-https://android.googlesource.com/kernel/gs}"
[0m[35m[instruQtor] stderr KERNEL_BRANCH="${KERNEL_BRANCH:-android-gs-mustang-6.12}"
[0m[35m[instruQtor] stderr KERNEL_DEFCONFIG="${KERNEL_DEFCONFIG:-gs501_defconfig}"
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr # Cross-compile toolchain.
[0m[35m[instruQtor] stderr CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}"
[0m[35m[instruQtor] stderr ARCH="${ARCH:-arm64}"
