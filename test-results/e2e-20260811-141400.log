[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr log_info()  { echo -e "[INFO]  $*"; }
[0m[35m[instruQtor] stderr log_ok()    { echo -e "[OK]    $*"; }
[0m[35m[instruQtor] stderr log_step()  { echo -e "\n=== $* ==="; }
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr main() {
[0m[35m[instruQtor] stderr     log_step "Kernel cross-compile CI job"
[0m[35m[instruQtor] stderr     log_info "repo:    ${KERNEL_REPO}"
[0m[35m[instruQtor] stderr     log_info "branch:  ${KERNEL_BRANCH}"
[0m[35m[instruQtor] stderr     log_info "defconfig: ${KERNEL_DEFCONFIG}"
[0m[35m[instruQtor] stderr     log_info "arch:    ${ARCH}, cross: ${CROSS_COMPILE}, jobs: ${JOBS}"
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr     # 0. Toolchain preflight
[0m[35m[instruQtor] stderr     if ! command -v "${CROSS_COMPILE}gcc" >/dev/null 2>&1; then
[0m[35m[instruQtor] stderr         echo "ERROR: cross compiler '${CROSS_COMPILE}gcc' not found." >&2
[0m[35m[instruQtor] stderr         echo "Install e.g. Debian/Ubuntu package 'gcc-aarch64-linux-gnu' or" >&2
[0m[35m[instruQtor] stderr         echo "equivalently provide a toolchain prefixed 'aarch64-linux-gnu-'." >&2
[0m[35m[instruQtor] stderr         exit 1
[0m[35m[instruQtor] stderr     fi
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr     mkdir -p "$WORK_DIR" "$ARTIFACT_DIR"
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr     # 1. Clone (or reuse) the kernel source at the verified branch.
[0m[35m[instruQtor] stderr     if [ ! -d "$WORK_DIR/.git" ]; then
[0m[35m[instruQtor] stderr         log_step "Cloning kernel source"
[0m[35m[instruQtor] stderr         git clone --depth 1 --single-branch \
[0m[35m[instruQtor] stderr             -b "$KERNEL_BRANCH" \
[0m[35m[instruQtor] stderr             "$KERNEL_REPO" "$WORK_DIR"
[0m[35m[instruQtor] stderr     else
[0m[35m[instruQtor] stderr         log_info "Reusing existing kernel tree at ${WORK_DIR}"
[0m[35m[instruQtor] stderr     fi
[0m[35m[instruQtor] stderr     cd "$WORK_DIR"
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr     # 2. Apply Nuxel patches.
[0m[35m[instruQtor] stderr     log_step "Applying Nuxel kernel patches"
[0m[35m[instruQtor] stderr     if [ -d "${NUXEL_ROOT}/kernel/patches" ]; then
[0m[35m[instruQtor] stderr         for patch in "${NUXEL_ROOT}/kernel/patches"/*.patch; do
[0m[35m[instruQtor] stderr             [ -f "$patch" ] || continue
[0m[35m[instruQtor] stderr             log_info "applying ${patch}"
[0m[35m[instruQtor] stderr             patch -p1 --forward --batch < "$patch" 2>/dev/null
[0m[35m[instruQtor] stderr         done
[0m[35m[instruQtor] stderr     fi
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr     # 3. Clean and generate the base vendor defconfig.
[0m[35m[instruQtor] stderr     log_step "Generating ${KERNEL_DEFCONFIG}"
[0m[35m[instruQtor] stderr     make ARCH="$ARCH" CROSS_COMPILE="$CROSS_COMPILE" mrproper
[0m[35m[instruQtor] stderr     make ARCH="$ARCH" CROSS_COMPILE="$CROSS_COMPILE" "$KERNEL_DEFCONFIG"
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr     # 4. Merge the Nuxel defconfig (same method as images/build.sh): copy
[0m[35m[instruQtor] stderr     #    kernel/defconfig on top and re-run olddefconfig so the NUXEL symbols
[0m[35m[instruQtor] stderr     #    (backed by the Kconfig entries in kernel/patches/0001) are retained.
[0m[35m[instruQtor] stderr     log_step "Merging Nuxel defconfig additions"
[0m[35m[instruQtor] stderr     cp "${NUXEL_ROOT}/kernel/defconfig" "arch/${ARCH}/configs/nuxel_defconfig"
[0m[35m[instruQtor] stderr     cat "arch/${ARCH}/configs/${KERNEL_DEFCONFIG}" \
[0m[35m[instruQtor] stderr         >> "arch/${ARCH}/configs/nuxel_defconfig"
[0m[35m[instruQtor] stderr     make ARCH="$ARCH" CROSS_COMPILE="$CROSS_COMPILE" nuxel_defconfig
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr     # 5. Verify the NUXEL Kconfig symbols survived olddefconfig. If the 0001
[0m[35m[instruQtor] stderr     #    patch (Kconfig/Makefile stubs) failed to apply, olddefconfig would
[0m[35m[instruQtor] stderr     #    silently strip CONFIG_NUXEL*, so fail loudly if any is missing.
[0m[35m[instruQtor] stderr     log_step "Verifying NUXEL symbols retained in .config"
[0m[35m[instruQtor] stderr     for sym in CONFIG_NUXEL CONFIG_NUXEL_PHONE CONFIG_NUXEL_BOOT_PARAM; do
[0m[35m[instruQtor] stderr         if ! grep -q "^${sym}=y" .config; then
[0m[35m[instruQtor] stderr             echo "ERROR: ${sym} not set to 'y' in .config (patch may have failed to apply)." >&2
[0m[35m[instruQtor] stderr             echo "       The NUXEL Kconfig entry does not exist, so olddefconfig stripped it." >&2
[0m[35m[instruQtor] stderr             exit 1
[0m[35m[instruQtor] stderr         fi
[0m[35m[instruQtor] stderr         log_ok "${sym}=y present in .config"
[0m[35m[instruQtor] stderr     done
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr     # 6. Compile the kernel image (surfaces real compile errors in the
[0m[35m[instruQtor] stderr     #    changed subsystems). Full parallel build is accepted; we build at least
[0m[35m[instruQtor] stderr     #    arch/arm64/boot/Image.
[0m[35m[instruQtor] stderr     log_step "Building kernel image (this may take a while)"
[0m[35m[instruQtor] stderr     make ARCH="$ARCH" CROSS_COMPILE="$CROSS_COMPILE" \
[0m[35m[instruQtor] stderr         -j"$JOBS" arch/arm64/boot/Image
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr     # 7. Store boot artifacts.
[0m[35m[instruQtor] stderr     log_step "Storing boot artifacts"
[0m[35m[instruQtor] stderr     local src=""
[0m[35m[instruQtor] stderr     for candidate in \
[0m[35m[instruQtor] stderr         "arch/${ARCH}/boot/Image.gz" \
[0m[35m[instruQtor] stderr         "arch/${ARCH}/boot/Image"; do
[0m[35m[instruQtor] stderr         if [ -f "$candidate" ]; then
[0m[35m[instruQtor] stderr             src="$candidate"
[0m[35m[instruQtor] stderr             break
[0m[35m[instruQtor] stderr         fi
[0m[35m[instruQtor] stderr     done
[0m[35m[instruQtor] stderr     if [ -z "$src" ]; then
[0m[35m[instruQtor] stderr         echo "ERROR: expected kernel boot image not produced." >&2
[0m[35m[instruQtor] stderr         exit 1
[0m[35m[instruQtor] stderr     fi
[0m[35m[instruQtor] stderr     cp "$src" "$ARTIFACT_DIR/" 2>/dev/null || true
[0m[35m[instruQtor] stderr     # Optionally gzip the raw Image for convenience/`Image.gz` artifact parity.
[0m[35m[instruQtor] stderr     if [ -f "arch/${ARCH}/boot/Image" ] && \
[0m[35m[instruQtor] stderr        [ ! -f "arch/${ARCH}/boot/Image.gz" ] && command -v gzip >/dev/null 2>&1; then
[0m[35m[instruQtor] stderr         gzip -c "arch/${ARCH}/boot/Image" > "$ARTIFACT_DIR/Image.gz"
[0m[35m[instruQtor] stderr     fi
[0m[35m[instruQtor] stderr     log_ok "Kernel build artifacts stored in: ${ARTIFACT_DIR}"
[0m[35m[instruQtor] stderr     ls -la "$ARTIFACT_DIR"
[0m[35m[instruQtor] stderr 
[0m[35m[instruQtor] stderr     log_ok "Kernel CI build completed (no hardware was flashed or booted)."
[0m[35m[instruQtor] stderr }
[0m[35m[instruQtor] stderr 
