[0m[36m[Qlarifier] stderr # configs/networkmanager/20-random-mac.conf
[0m[36m[Qlarifier] stderr # =============================================================================
[0m[36m[Qlarifier] stderr # Nuxel privacy default: randomize WiFi hardware (MAC) addresses.
[0m[36m[Qlarifier] stderr #
[0m[36m[Qlarifier] stderr # Installed system-wide (not per-connection) as a NetworkManager config drop:
[0m[36m[Qlarifier] stderr #   /etc/NetworkManager/conf.d/20-random-mac.conf
[0m[36m[Qlarifier] stderr #
[0m[36m[Qlarifier] stderr # This randomizes the MAC address used for WiFi and 802.1X/Ethernet scanning,
[0m[36m[Qlarifier] stderr # reducing device tracking across networks. Per-connection settings made
[0m[36m[Qlarifier] stderr # explicitly by the user still take precedence over these defaults.
[0m[36m[Qlarifier] stderr #
[0m[36m[Qlarifier] stderr # Syntax reference (NetworkManager keyfile / config.d):
[0m[36m[Qlarifier] stderr #   - [device] covers device-level behaviour (scanning).
[0m[36m[Qlarifier] stderr #   - [connection] covers per-connection behaviour unless the user overrides
[0m[36m[Qlarifier] stderr #     it in a specific connection profile (where 'wifi.cloned-mac-address'
[0m[36m[Qlarifier] stderr #     < 'ethernet.cloned-mac-address' etc. live).
[0m[36m[Qlarifier] stderr #
[0m[36m[Qlarifier] stderr # NOTE (stable behaviour):
[0m[36m[Qlarifier] stderr #   'random' generates a fresh MAC per network (random + stable per ssid are
[0m[36m[Qlarifier] stderr #   equivalent for scanning); 'stable' yields a host-derived MAC that is the
[0m[36m[Qlarifier] stderr #   same across connections to the same SSID. We ship 'random' here for
[0m[36m[Qlarifier] stderr #   maximum privacy; switch to 'stable' if you prefer the same address for a
[0m[36m[Qlarifier] stderr #   given network across reboots.
[0m[36m[Qlarifier] stderr # =============================================================================
[0m[36m[Qlarifier] stderr 
[0m[36m[Qlarifier] stderr # --- Randomize MAC address when scanning for networks ----------------------
[0m[36m[Qlarifier] stderr [device]
[0m[36m[Qlarifier] stderr wifi.scan-rand-mac-address=yes
[0m[36m[Qlarifier] stderr 
[0m[36m[Qlarifier] stderr # --- Randomize the WiFi MAC address for new/activated connections ----------
[0m[36m[Qlarifier] stderr # Canonical NetworkManager location for the per-connection WiFi MAC override.
[0m[36m[Qlarifier] stderr [connection]
[0m[36m[Qlarifier] stderr wifi.cloned-mac-address=random
[0m[36m[Qlarifier] stderr ---
[0m[36m[Qlarifier] stderr # configs/networkmanager/20-doht.conf
[0m[36m[Qlarifier] stderr # =============================================================================
[0m[36m[Qlarifier] stderr # Nuxel privacy default: use encrypted DNS (DNS-over-HTTPS / DNS-over-TLS).
[0m[36m[Qlarifier] stderr #
[0m[36m[Qlarifier] stderr # Installed system-wide (not per-connection) as a NetworkManager config drop:
[0m[36m[Qlarifier] stderr #   /etc/NetworkManager/conf.d/20-doht.conf
[0m[36m[Qlarifier] stderr #
[0m[36m[Qlarifier] stderr # This default makes DNS lookups go through an encrypted transport so that
[0m[36m[Qlarifier] stderr # queries are not readable by on-path observers on the local network or by the
[0m[36m[Qlarifier] stderr # upstream ISP. NetworkManager hands resolver settings to a local stub resolver
[0m[36m[Qlarifier] stderr # which performs the actual encrypted lookups.
[0m[36m[Qlarifier] stderr #
[0m[36m[Qlarifier] stderr # Two supported encrypted-DNS strategies:
[0m[36m[Qlarifier] stderr #   * DNS-over-HTTPS (DoH)  — port 443, best default in networks that block
[0m[36m[Qlarifier] stderr #                             port 853. Used by the ipv4.dns URI below.
[0m[36m[Qlarifier] stderr #   * DNS-over-TLS  (DoT)   — port 853, lighter weight; see the optional
[0m[36m[Qlarifier] stderr #                             section at the bottom of this file.
[0m[36m[Qlarifier] stderr #
[0m[36m[Qlarifier] stderr # TARGET NOTE (mustang Alpine / OpenRC):
[0m[36m[Qlarifier] stderr #   systemd-resolved is the resolver backend used on the Fedora-style VM build
[0m[36m[Qlarifier] stderr #   selected by [main] dns=systemd-resolved below. Alpine does NOT ship
[0m[36m[Qlarifier] stderr #   systemd-resolved, so on the mustang Alpine target use the portability
[0m[36m[Qlarifier] stderr #   alternative: install 'stubby' (native DNS-over-TLS stub) or 'dnsmasq'
[0m[36m[Qlarifier] stderr #   configured to forward to a DoT/DoH proxy, point NetworkManager's DNS at
[0m[36m[Qlarifier] stderr #   127.0.0.1, and leave [main] dns unset (Alpine NetworkManager default).
[0m[36m[Qlarifier] stderr # =============================================================================
[0m[36m[Qlarifier] stderr 
[0m[36m[Qlarifier] stderr # --- Route DNS through the local systemd-resolved stub (Fedora/VM target) --
[0m[36m[Qlarifier] stderr [main]
[0m[36m[Qlarifier] stderr dns=systemd-resolved
[0m[36m[Qlarifier] stderr 
[0m[36m[Qlarifier] stderr # --- Default encrypted-resolver endpoint for new connections ---------------
[0m[36m[Qlarifier] stderr # When a connection specifies no DNS server of its own, NetworkManager hands
[0m[36m[Qlarifier] stderr # these DoH endpoints to systemd-resolved, which resolves them over HTTPS.
[0m[36m[Qlarifier] stderr # This is a privacy-friendly connecting default; users may override per
[0m[36m[Qlarifier] stderr # connection with their own preferred resolver.
[0m[36m[Qlarifier] stderr [connection]
[0m[36m[Qlarifier] stderr ipv4.dns=1.1.1.1#https://cloudflare-dns.com/dns-query
[0m[36m[Qlarifier] stderr 
[0m[36m[Qlarifier] stderr # --- OPTIONAL: switch from DoH to DNS-over-TLS ------------------------------
[0m[36m[Qlarifier] stderr # To prefer DoT instead of DoH, replace the ipv4.dns line above with a plain
[0m[36m[Qlarifier] stderr # resolver address and enable DoT in the resolver configuration:
[0m[36m[Qlarifier] stderr #
[0m[36m[Qlarifier] stderr #   [connection]
[0m[36m[Qlarifier] stderr #   ipv4.dns=1.1.1.1
[0m[36m[Qlarifier] stderr #
[0m[36m[Qlarifier] stderr #   # /etc/systemd/resolved.conf:
[0m[36m[Qlarifier] stderr #   # [Resolve]
[0m[36m[Qlarifier] stderr #   # DNSOverTLS=yes
[0m[36m[Qlarifier] stderr #   # DNS=1.1.1.1
[0m[36m[Qlarifier] stderr # =============================================================================
