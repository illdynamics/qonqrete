{
  "name": "qonqrete",
  "displayName": "QonQrete",
  "description": "QonQrete is a deterministic AI coding agent for VS Code enabling autonomous code generation, local AI development, and secure sandboxed software construction workflows.",
  "version": "1.4.2",
  "publisher": "QonQrete",
  "homepage": "https://qonqrete.sh",
  "icon": "assets/qonqrete-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/illdynamics/qonqrete"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "qonqrete",
    "ai",
    "ai coding",
    "ai assistant",
    "ai programming",
    "coding agent",
    "ai agent",
    "agentic ai",
    "code generation",
    "coding automation",
    "developer ai",
    "local ai",
    "offline ai",
    "self-hosted ai",
    "deterministic ai",
    "privacy ai",
    "sandboxed ai",
    "secure ai",
    "llm",
    "autonomous coding"
  ],
  "activationEvents": [
    "workspaceContains:**/tasq.md",
    "workspaceContains:**/qonqrete.sh",
    "workspaceContains:**/worqspace/config.yaml",
    "onView:qonqreteControlPanel",
    "onCommand:qonqrete.runTasq",
    "onCommand:qonqrete.initWorkspace",
    "onCommand:qonqrete.resumeRun",
    "onCommand:qonqrete.cleanQages",
    "onCommand:qonqrete.showStatus",
    "workspaceContains:**/.qonqrete/qonqrete.sh",
    "onCommand:qonqrete.deployToWorkspace",
    "onCommand:qonqrete.createTasq",
    "onCommand:qonqrete.setAIConfig"
  ],
  "bugs": {
    "url": "https://github.com/illdynamics/qonqrete/issues"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "qonqrete.createTasq",
        "title": "QonQrete: Create Task File",
        "icon": "$(new-file)"
      },
      {
        "command": "qonqrete.deployToWorkspace",
        "title": "QonQrete: Deploy to Workspace",
        "icon": "$(cloud-download)"
      },
      {
        "command": "qonqrete.setAIConfig",
        "title": "QonQrete: Set AI Configuration",
        "icon": "$(hubot)"
      },
      {
        "command": "qonqrete.initWorkspace",
        "title": "QonQrete: Init Workspace",
        "icon": "$(package)"
      },
      {
        "command": "qonqrete.runTasq",
        "title": "QonQrete: Run Tasq",
        "icon": "$(play)"
      },
      {
        "command": "qonqrete.runAsQonqreteTasq",
        "title": "QonQrete: Run Markdown as QonQrete Task",
        "icon": "$(play-circle)"
      },
      {
        "command": "qonqrete.resumeRun",
        "title": "QonQrete: Resume Run",
        "icon": "$(debug-continue)"
      },
      {
        "command": "qonqrete.cleanQages",
        "title": "QonQrete: Clean Qages",
        "icon": "$(trash)"
      },
      {
        "command": "qonqrete.openConfigDialog",
        "title": "QonQrete: Configure Run",
        "icon": "$(gear)"
      },
      {
        "command": "qonqrete.showStatus",
        "title": "QonQrete: Show Status",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceFilename == tasq.md",
          "command": "qonqrete.runTasq",
          "group": "qonqrete@1"
        },
        {
          "when": "resourceExtname == .md && resourceFilename != tasq.md",
          "command": "qonqrete.runAsQonqreteTasq",
          "group": "qonqrete@1"
        }
      ],
      "editor/context": [
        {
          "when": "resourceFilename == tasq.md",
          "command": "qonqrete.runTasq",
          "group": "qonqrete@1"
        },
        {
          "when": "resourceExtname == .md && resourceFilename != tasq.md",
          "command": "qonqrete.runAsQonqreteTasq",
          "group": "qonqrete@1"
        }
      ],
      "editor/title": [
        {
          "when": "resourceFilename == tasq.md",
          "command": "qonqrete.runTasq",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "qonqrete.deployToWorkspace",
          "when": "view == qonqreteControlPanel",
          "group": "navigation@0"
        },
        {
          "command": "qonqrete.runTasq",
          "when": "view == qonqreteControlPanel",
          "group": "navigation@1"
        },
        {
          "command": "qonqrete.resumeRun",
          "when": "view == qonqreteControlPanel",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qonqrete-sidebar",
          "title": "QonQrete",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "qonqrete-sidebar": [
        {
          "type": "webview",
          "id": "qonqreteControlPanel",
          "name": "Control Panel"
        }
      ]
    },
    "configuration": {
      "title": "QonQrete",
      "properties": {
        "qonqrete.defaultSensitivity": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 16,
          "description": "Default briq sensitivity level (0-16). Higher values create more granular briqs."
        },
        "qonqrete.defaultAutoBriqSensitivity": {
          "type": "boolean",
          "default": true,
          "description": "Use --auto-briq-sensitivity by default. When enabled, the manual default sensitivity slider is ignored unless you force -b."
        },
        "qonqrete.defaultCycles": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 50,
          "description": "Default number of execution cycles (1-50)."
        },
        "qonqrete.defaultAutonomous": {
          "type": "boolean",
          "default": true,
          "description": "Enable autonomous mode by default (no user confirmations)."
        },
        "qonqrete.noSync": {
          "type": "boolean",
          "default": true,
          "description": "Skip repo-root sync-back by default and keep outputs in qage/qonstructions (--no-sync)."
        },
        "qonqrete.defaultMode": {
          "type": "string",
          "default": "program",
          "enum": [
            "program",
            "enterprise",
            "security",
            "data",
            "devops",
            "web"
          ],
          "enumDescriptions": [
            "General programming mode",
            "Enterprise application development",
            "Security-focused development",
            "Data processing and analysis",
            "DevOps and infrastructure",
            "Web development"
          ],
          "description": "Default operational mode for QonQrete runs."
        },
        "qonqrete.containerEngine": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "docker",
            "podman"
          ],
          "enumDescriptions": [
            "Auto-detect available container engine",
            "Force Docker",
            "Force Podman"
          ],
          "description": "Container engine to use for QonQrete execution."
        },
        "qonqrete.useSqrapyard": {
          "type": "boolean",
          "default": true,
          "description": "Seed qodeyard from current repository by default (--seed-repo; legacy --sqrapyard alias)."
        },
        "qonqrete.qonqretePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to qonqrete.sh script (leave empty for auto-detection)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo skipping compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "npm run compile && node out/ui/pathSafety.test.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.32.0",
    "eslint": "^8.45.0",
    "typescript": "^5.1.0"
  },
  "license": "Apache-2.0"
}
