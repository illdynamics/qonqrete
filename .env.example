# Example environment variables file
#
# In worqspace/config.yaml you can set per-agent AI providers and models.
# Depending on which ones you set there, you need to set the API keys here.

# OpenAI (also used by Codex CLI)
#export OPENAI_API_KEY='your-key'

# DeepSeek (also required for provider: codeseeq)
#export DEEPSEEK_API_KEY='your-key'

# ChatGPT account provider (default, provider: chatgpt) needs NO API key:
# QonQrete triggers  codeseeq login  -> "Sign in with ChatGPT"  on first run
# when no sign-in exists yet, and reuses that session for every agent.

# Google Gemini
#export GOOGLE_API_KEY='your-key'     # or GEMINI_API_KEY

# Anthropic (also used by Claude Code CLI)
#export ANTHROPIC_API_KEY='your-key'

# Qwen
#export QWEN_API_KEY='your-key'

# OpenRouter
#export OPENROUTER_API_KEY='your-key'

# Venice
#export VENICE_API_KEY='your-key'

# Local OpenAI-compatible providers (provider: llama-cpp | mlx) — the model
# always runs SEPARATELY (llama-server for GGUF, mlx_lm.server for MLX); qq
# only talks to the server over host:port. No API key is required locally.
# Llama-cpp = GGUF models via llama.cpp, default endpoint :8888:
#export QQ_LLAMA_CPP_ENDPOINT='http://127.0.0.1:8888/v1'
#export QQ_LLAMA_CPP_API_KEY='optional-local-key'
# MLX = MLX safetensors models on Apple Silicon, default endpoint :8080
# (run separately, e.g.: mlx_lm.server --model <path-or-hf-id> --port 8080):
#export QQ_MLX_ENDPOINT='http://127.0.0.1:8080/v1'
#export QQ_MLX_API_KEY='optional-local-key'
# Equivalent persistent overrides can live in config/qq.yaml under
# `local_endpoints:` (llama-cpp / mlx keys) instead of the env vars above.
# When qq runs inside WSL but llama-server runs on the Windows host, qq
# auto-detects the Windows host via the WSL NAT gateway (server must use
# --host 0.0.0.0). QQ_WSL_HOST_IP optionally seeds/overrides that detection:
#export QQ_WSL_HOST_IP='172.24.64.1'

# Optional: point codeseeq/chatgpt providers at a specific system CodeSeeq
# launcher (default: the `codeseeq` found on PATH — never a ./qq/codeseeq copy).
#export QQ_CODESEEQ_BIN='codeseeq'
