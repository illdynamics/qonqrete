# Example environment variables file
#
# In worqspace/config.yaml you can set per-agent AI providers and models.
# Depending on which ones you set there, you need to set the API keys here.

# OpenAI (also used by Codex CLI)
#export OPENAI_API_KEY='your-key'

# DeepSeek (also required for provider: codeseeq)
#export DEEPSEEK_API_KEY='your-key'

# ChatGPT account provider (default, provider: chatgpt) needs NO API key:
# QonQrete triggers  codeseeq login  -> "Sign in with ChatGPT"  on first run
# when no sign-in exists yet, and reuses that session for every agent.

# Google Gemini
#export GOOGLE_API_KEY='your-key'     # or GEMINI_API_KEY

# Anthropic (also used by Claude Code CLI)
#export ANTHROPIC_API_KEY='your-key'

# Qwen
#export QWEN_API_KEY='your-key'

# OpenRouter
#export OPENROUTER_API_KEY='your-key'

# Venice
#export VENICE_API_KEY='your-key'

# Local/LAN providers (API keys optional, api_base_url required in per-agent config)
# MLX (Apple Silicon local runtime):
#export MLX_API_KEY='optional-local-key'
# Llama-cpp (local runtime):
#export LLAMA_CPP_API_KEY='optional-local-key'

# Optional: point codeseeq/chatgpt providers at a specific system CodeSeeq
# launcher (default: the `codeseeq` found on PATH — never a ./qq/codeseeq copy).
#export QQ_CODESEEQ_BIN='codeseeq'
