<idea-plugin>
    <id>sh.qonqrete.intellij</id>
    <name>QonQrete</name>

```
<vendor email="ricky@qonqrete.sh" url="https://qonqrete.sh">QonQrete</vendor>

<description><![CDATA[
    <h2>QonQrete</h2>

    <p>
    QonQrete is a deterministic AI coding agent for IntelliJ enabling autonomous code generation,
    local AI development, and secure sandboxed software construction workflows.
    </p>

    <h3>Features</h3>
    <ul>
        <li><b>Run Tasq</b> – Execute QonQrete builds directly from <code>tasq.md</code></li>
        <li><b>Run Any Markdown</b> – Run any markdown file as a temporary tasq</li>
        <li><b>Tool Window</b> – Control panel with status, config and qage browser</li>
        <li><b>Status Widget</b> – Real-time status indicator in the IntelliJ status bar</li>
        <li><b>Qage Browser</b> – Browse generated artifacts with timestamps</li>
        <li><b>Run State Tracking</b> – Marker-based exit detection and auto refresh</li>
        <li><b>Local-First Execution</b> – Runs fully local using your QonQrete runtime</li>
    </ul>

    <h3>Requirements</h3>
    <ul>
        <li>Bash shell (Git Bash on Windows, native on macOS/Linux)</li>
        <li>Docker or Podman for container execution</li>
        <li>A QonQrete project with <code>qonqrete.sh</code></li>
    </ul>

    <p>
    Learn more at <a href="https://qonqrete.sh">qonqrete.sh</a>.
    </p>
]]></description>

<depends>com.intellij.modules.platform</depends>
<depends>org.jetbrains.plugins.terminal</depends>

<extensions defaultExtensionNs="com.intellij">

    <projectService serviceImplementation="sh.qonqrete.intellij.services.QonQreteProjectService"/>

    <applicationService serviceImplementation="sh.qonqrete.intellij.services.QonQreteSettingsState"/>

    <toolWindow
        id="QonQrete"
        anchor="right"
        icon="/icons/qonqrete-13.svg"
        factoryClass="sh.qonqrete.intellij.ui.QonQreteToolWindowFactory"/>

    <statusBarWidgetFactory
        id="QonQreteStatusWidget"
        implementation="sh.qonqrete.intellij.ui.QonQreteStatusWidgetFactory"
        order="after ReadOnlyAttribute"/>

    <projectConfigurable
        parentId="tools"
        instance="sh.qonqrete.intellij.ui.QonQreteSettingsConfigurable"
        id="sh.qonqrete.intellij.settings"
        displayName="QonQrete"
        nonDefaultProject="true"/>

    <postStartupActivity
        implementation="sh.qonqrete.intellij.services.QonQreteStartupActivity"/>

    <editorNotificationProvider
        implementation="sh.qonqrete.intellij.ui.TasqEditorNotificationProvider"/>

    <notificationGroup
        id="QonQrete Notifications"
        displayType="BALLOON"/>
</extensions>

<actions>

    <action
        id="QonQrete.RunTasq"
        class="sh.qonqrete.intellij.actions.RunTasqAction"
        text="QonQrete: Run Tasq"
        description="Run QonQrete with canonical tasq.md"
        icon="AllIcons.Actions.Execute">
        <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt Q"/>
        <add-to-group group-id="RunMenu" anchor="last"/>
    </action>

    <action
        id="QonQrete.RunAsQonqreteTasq"
        class="sh.qonqrete.intellij.actions.RunAsQonqreteTasqAction"
        text="QonQrete: Run as Tasq"
        description="Run current markdown file as QonQrete tasq"
        icon="AllIcons.Actions.Execute"/>

    <action
        id="QonQrete.InitWorkspace"
        class="sh.qonqrete.intellij.actions.InitWorkspaceAction"
        text="QonQrete: Init Workspace"
        description="Initialize QonQrete container image"
        icon="AllIcons.Actions.Download"/>

    <action
        id="QonQrete.ResumeRun"
        class="sh.qonqrete.intellij.actions.ResumeRunAction"
        text="QonQrete: Resume Run"
        description="Resume from existing qage"
        icon="AllIcons.Actions.Resume"/>

    <action
        id="QonQrete.CleanQages"
        class="sh.qonqrete.intellij.actions.CleanQagesAction"
        text="QonQrete: Clean Qages"
        description="Clean qage directories"
        icon="AllIcons.Actions.GC"/>

    <action
        id="QonQrete.ShowStatus"
        class="sh.qonqrete.intellij.actions.ShowStatusAction"
        text="QonQrete: Show Status"
        description="Show QonQrete status"
        icon="AllIcons.General.Information"/>

    <action
        id="QonQrete.OpenConfigDialog"
        class="sh.qonqrete.intellij.actions.OpenConfigDialogAction"
        text="QonQrete: Configure Run"
        description="Open run configuration dialog"
        icon="AllIcons.General.Settings"/>

</actions>
```

</idea-plugin>

